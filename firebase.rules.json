{
  "rules": {
    "espaces": {
      "$espace": {

        "quizzes": {
          ".read": true,
          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          "$quiz": {
            ".validate": "newData.hasChildren(['id', 'title', 'rev', 'updatedBy']) && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",
            "rev": { ".validate": "newData.isNumber()" },
            "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
          }
        },

        "identite": {
          ".read": true,
          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".validate": "!newData.exists() || newData.hasChildren(['titre'])"
        },

        "presentation": {
          ".read": true,
          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()"
        },

        "corbeille": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          "$quiz": {
            ".validate": "!newData.exists() || newData.hasChildren(['id', 'title', 'supprimeLe'])"
          }
        },

        "membres": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".write": false,

          "$uid": {
            ".write": "auth != null && ((root.child('espaces').child($espace).child('membres').child(auth.uid).exists() && !root.child('espaces').child($espace).child('gerants').child($uid).exists()) || ($uid === auth.uid && !data.exists() && newData.val() === true && auth.token.email != null && auth.token.email_verified === true && root.child('espaces').child($espace).child('invitations').child(auth.token.email.replace('.', ',')).exists()))",
            ".validate": "newData.isBoolean()"
          }
        },

        "invitations": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          "$courriel": {
            ".read": "auth != null && auth.token.email != null && auth.token.email_verified === true && $courriel === auth.token.email.replace('.', ',')",
            ".write": "auth != null && auth.token.email != null && auth.token.email_verified === true && $courriel === auth.token.email.replace('.', ',') && !newData.exists()",
            ".validate": "newData.hasChildren(['par', 'le']) && newData.child('par').val() === auth.uid && newData.child('le').val() <= now"
          }
        },

        "attente": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('espaces').child($espace).child('membres').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['courriel', 'prenom', 'le']) && $uid === auth.uid && newData.child('courriel').val() === auth.token.email && auth.token.email_verified === true && newData.child('le').val() <= now"
          }
        },

        "stats": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          "$quiz": {
            ".validate": "root.child('espaces').child($espace).child('quizzes').child($quiz).exists()",
            "total": {
              ".write": "newData.exists()",
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
            },
            "debuts": {
              ".write": "newData.exists()",
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
            },
            "profils": {
              "$profil": {
                ".write": "newData.exists()",
                ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
              }
            }
          }
        },

        "profils": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('espaces').child($espace).child('membres').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['prenom'])"
          }
        },

        "vitrines": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('espaces').child($espace).child('membres').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['nom'])"
          }
        },

        "gerants": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".write": false
        }

      }
    }
  }
}
