{
  "rules": {
    "espaces": {
      "$espace": {

        "quizzes": {
          ".read": true,

          ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          "$quiz": {
            ".validate": "newData.hasChildren(['id', 'title', 'rev', 'updatedBy']) && ((!data.exists() || !data.hasChild('rev')) ? newData.child('rev').val() >= 1 : newData.child('rev').val() === data.child('rev').val() + 1)",

            "rev": { ".validate": "newData.isNumber()" },

            "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" }
          }
        },

        "membres": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          ".write": false,

          "$uid": {
            ".write": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists() && !root.child('espaces').child($espace).child('gerants').child($uid).exists()",

            ".validate": "newData.isBoolean()"
          }
        },

        "stats": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          "$quiz": {
            "total": {
              ".write": true,
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
            },

            "profils": {
              "$profil": {
                ".write": true,
                ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
              }
            }
          }
        },

        "profils": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",

          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['prenom'])"
          }
        },

        "vitrines": {
          ".read": true,

          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nom'])"
          }
        },

        "gerants": {
          ".read": "auth != null && root.child('espaces').child($espace).child('membres').child(auth.uid).exists()",
          ".write": false
        }

      }
    }
  }
}
